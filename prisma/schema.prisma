generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}
enum SwipeType {
  LIKE
  SKIP
}
enum ParticipantStatus {
  JOINED
  LEFT
  CANCELLED
}
enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  telegramId String @unique
  telegramUsername String?
  firstName String
  lastName String?
  role Role @default(USER)
  isBlocked Boolean @default(false)
  isActive Boolean @default(true)
  isVerified Boolean @default(false)
  botOptIn Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile Profile?
  sessions Session[]
  photos UserPhoto[]
  goals UserGoal[]
  sports UserSportInterest[]
  preferences DatingPreferences?
  location LocationStatus?
  events Event[]
  participants EventParticipant[]
  saved SavedEvent[]
  clubs Club[]
  memberships ClubMember[]
  notifications Notification[]
  sentSwipes Swipe[] @relation("SwipeFrom")
  receivedSwipes Swipe[] @relation("SwipeTo")
  matchesA Match[] @relation("MatchA")
  matchesB Match[] @relation("MatchB")
  blocksSent Block[] @relation("BlockFrom")
  blocksReceived Block[] @relation("BlockTo")
}
model Profile {
  userId String @id @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  birthDate DateTime @db.Date
  gender String
  city String
  bio String @default("")
  sportLevel String @default("BEGINNER")
  datingEnabled Boolean @default(false)
  isHidden Boolean @default(false)
  contactConsent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model SportInterest {
  code String @id
  name String
  users UserSportInterest[]
}
model UserSportInterest {
  userId String @db.Uuid
  sportCode String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  sport SportInterest @relation(fields:[sportCode],references:[code])
  @@id([userId,sportCode])
}
model UserGoal {
  userId String @db.Uuid
  goal String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,goal])
}
model DatingPreferences {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  interestedInGender String[]
  minAge Int @default(18)
  maxAge Int @default(45)
  maxDistance Int @default(25)
}
model UserPhoto {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  url String
  storageKey String @unique
  sortOrder Int
  createdAt DateTime @default(now())
  @@index([userId])
}
model LocationStatus {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  publicLatitude Float
  publicLongitude Float
  statusType String
  audience String @default("COMMUNITY")
  showDistance Boolean @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model Swipe {
  fromUser User @relation("SwipeFrom",fields:[fromUserId],references:[id],onDelete:Cascade)
  toUser User @relation("SwipeTo",fields:[toUserId],references:[id],onDelete:Cascade)
  fromUserId String @db.Uuid
  toUserId String @db.Uuid
  mode String
  type SwipeType
  createdAt DateTime @default(now())
  @@id([fromUserId,toUserId,mode])
  @@index([toUserId,type])
}
model Match {
  userA User @relation("MatchA",fields:[userAId],references:[id],onDelete:Cascade)
  userB User @relation("MatchB",fields:[userBId],references:[id],onDelete:Cascade)
  id String @id @default(uuid()) @db.Uuid
  userAId String @db.Uuid
  userBId String @db.Uuid
  mode String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([userAId,userBId,mode])
}
model Event {
  id String @id @default(uuid()) @db.Uuid
  creatorId String @db.Uuid
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  title String
  description String
  category String
  city String
  dateStart DateTime
  dateEnd DateTime
  latitude Float
  longitude Float
  locationName String
  capacity Int
  difficulty String
  parameters Json @default("{}")
  price Int @default(0)
  isPrivate Boolean @default(false)
  isCancelled Boolean @default(false)
  isOfficial Boolean @default(false)
  telegramChatUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants EventParticipant[]
  saved SavedEvent[]
  @@index([city,dateStart])
}
model EventParticipant {
  eventId String @db.Uuid
  userId String @db.Uuid
  event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  status ParticipantStatus @default(JOINED)
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  @@id([eventId,userId])
}
model SavedEvent {
  userId String @db.Uuid
  eventId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@id([userId,eventId])
}
model Club {
  id String @id @default(uuid()) @db.Uuid
  name String
  description String
  avatarUrl String?
  creatorId String @db.Uuid
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  isOfficial Boolean @default(false)
  telegramChatUrl String?
  createdAt DateTime @default(now())
  members ClubMember[]
}
model ClubMember {
  clubId String @db.Uuid
  userId String @db.Uuid
  role String @default("MEMBER")
  club Club @relation(fields:[clubId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([clubId,userId])
}
model Block {
  blocker User @relation("BlockFrom",fields:[blockerId],references:[id],onDelete:Cascade)
  blocked User @relation("BlockTo",fields:[blockedId],references:[id],onDelete:Cascade)
  blockerId String @db.Uuid
  blockedId String @db.Uuid
  createdAt DateTime @default(now())
  @@id([blockerId,blockedId])
}
model Report {
  id String @id @default(uuid()) @db.Uuid
  reporterId String @db.Uuid
  targetUserId String? @db.Uuid
  targetEventId String? @db.Uuid
  targetPhotoId String? @db.Uuid
  reason String
  description String
  status ReportStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ModerationAction {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  targetId String
  action String
  reason String
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  type String
  payload Json
  dedupeKey String @unique
  readAt DateTime?
  createdAt DateTime @default(now())
}
model Outbox {
  id String @id @default(uuid()) @db.Uuid
  kind String
  payload Json
  dedupeKey String @unique
  attempts Int @default(0)
  availableAt DateTime @default(now())
  processedAt DateTime?
  @@index([processedAt,availableAt])
}
model AnalyticsEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  name String
  properties Json @default("{}")
  createdAt DateTime @default(now())
  @@index([name,createdAt])
}
model RateBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model WebhookUpdate {
  id BigInt @id
  createdAt DateTime @default(now())
}
